# Copy this file to .env and fill in your real values.
# Never commit the real .env file to Git.

PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gw_land_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (used to sign login tokens)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMTP (for password reset emails) — optional for now.
# Leave blank during development: emails will just print to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend URL — used in sitemap.xml to build the full listing URLs.
# Set this to your React app's production URL before going live.
FRONTEND_URL=http://localhost:3000

# "Continue with Google" — create a project + OAuth Client ID (Web application)
# at https://console.cloud.google.com/apis/credentials, then add
# GOOGLE_CALLBACK_URL below as an Authorized redirect URI on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# "Continue with Facebook" — create an app at https://developers.facebook.com/apps,
# add the "Facebook Login" product, then add FACEBOOK_CALLBACK_URL below under
# Facebook Login > Settings > Valid OAuth Redirect URIs.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# MTN Mobile Money (MoMo) Payment Gateway
# Get your API key from https://momodeveloper.mtn.com
# MOMO_WEBHOOK_SECRET is used to verify webhook calls from MTN in production.
# Leave it blank in development — all webhooks will be accepted without signature validation.
MOMO_API_KEY=
MOMO_API_USER=
MOMO_SUBSCRIPTION_KEY=
MOMO_ENVIRONMENT=sandbox
MOMO_WEBHOOK_SECRET=
